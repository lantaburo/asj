generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AiBrain {
  id           String   @id
  purpose      String   @unique
  systemPrompt String
  updatedAt    DateTime
}

model Article {
  id             String   @id
  title          String
  slug           String   @unique
  author         String
  content        String
  imageUrl       String?
  version        String   @default("1.0")
  publishDate    DateTime @default(now())
  seoDescription String?
  seoKeywords    String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
}

model Attendance {
  id             String           @id
  sessionId      String
  userId         String
  checkInTime    DateTime         @default(now())
  gpsCoordinates Json?
  selfieUrl      String?
  status         AttendanceStatus @default(PRESENT)
  deviceInfo     String?
  ClassSession   ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User           User             @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

model Batch {
  id                            String         @id
  programId                     String
  instructorId                  String?
  startDate                     DateTime
  endDate                       DateTime
  quota                         Int
  price                         Int?
  status                        BatchStatus    @default(OPEN)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime
  assessorId                    String?
  classroomId                   String?
  pricePackages                 Json?
  User_Batch_assessorIdToUser   User?          @relation("Batch_assessorIdToUser", fields: [assessorId], references: [id])
  Classroom                     Classroom?     @relation(fields: [classroomId], references: [id])
  User_Batch_instructorIdToUser User?          @relation("Batch_instructorIdToUser", fields: [instructorId], references: [id])
  Program                       Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  ClassSession                  ClassSession[]
  Enrollment                    Enrollment[]
}

model CertificateConfig {
  id             String   @id
  pdfTemplateUrl String?
  signatureUrl   String?
  passingGrade   Int      @default(70)
  updatedAt      DateTime
  programId      String?  @unique
  signatoryName  String?
  validityMonths Int?
  signatoryTitle String?
  Program        Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model ClassSession {
  id                                   String       @id
  batchId                              String
  classroomId                          String?
  instructorId                         String?
  title                                String
  sessionDate                          DateTime
  startTime                            DateTime
  endTime                              DateTime
  locationType                         String       @default("Classroom")
  createdAt                            DateTime     @default(now())
  assessorId                           String?
  jp                                   Int          @default(1)
  Attendance                           Attendance[]
  User_ClassSession_assessorIdToUser   User?        @relation("ClassSession_assessorIdToUser", fields: [assessorId], references: [id])
  Batch                                Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  Classroom                            Classroom?   @relation(fields: [classroomId], references: [id])
  User_ClassSession_instructorIdToUser User?        @relation("ClassSession_instructorIdToUser", fields: [instructorId], references: [id])
}

model Classroom {
  id           String         @id
  roomName     String
  capacity     Int
  facilities   Json?
  isAvailable  Boolean        @default(true)
  Batch        Batch[]
  ClassSession ClassSession[]
}

model Enrollment {
  id               String           @id
  batchId          String
  userId           String
  registrationDocs Json?
  assessmentStatus AssessmentStatus @default(PENDING)
  certificateNum   String?          @unique
  expiryDate       DateTime?
  qrVerifyCode     String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  Batch            Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  User             User             @relation(fields: [userId], references: [id])
  K3Log            K3Log[]

  @@unique([batchId, userId])
}

model K3Log {
  id           String     @id
  enrollmentId String
  activityName String
  safetyScore  Int?
  verifiedById String?
  evidenceUrl  String?
  gpsWatermark Json?
  timestamp    DateTime   @default(now())
  Enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  User         User?      @relation(fields: [verifiedById], references: [id])
}

model Program {
  id                String             @id
  title             String
  category          ProgramCategory
  industryType      String             @default("Umum")
  description       String?
  curriculum        Json?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  customCategory    String?
  Batch             Batch[]
  CertificateConfig CertificateConfig?
  UnitSchema        UnitSchema[]
}

model SchemaUnit {
  id           String     @id
  unitSchemaId String
  unitCode     String
  title        String
  orderIndex   Int        @default(1)
  isMandatory  Boolean    @default(true)
  criteria     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  UnitSchema   UnitSchema @relation(fields: [unitSchemaId], references: [id], onDelete: Cascade)

  @@unique([unitSchemaId, unitCode])
  @@index([unitSchemaId, orderIndex])
}

model UnitSchema {
  id          String       @id
  programId   String?
  code        String       @unique
  title       String
  level       String?
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  SchemaUnit  SchemaUnit[]
  Program     Program?     @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model User {
  id                                           String           @id
  email                                        String           @unique
  phone                                        String?          @unique
  fullName                                     String
  role                                         Role             @default(TRAINEE)
  isActive                                     Boolean          @default(true)
  createdAt                                    DateTime         @default(now())
  updatedAt                                    DateTime
  passwordHash                                 String?
  instructorLevel                              InstructorLevel?
  participantDocuments                         Json?
  licenseNumber                                String?
  profilePictureUrl                            String?
  Attendance                                   Attendance[]
  Batch_Batch_assessorIdToUser                 Batch[]          @relation("Batch_assessorIdToUser")
  Batch_Batch_instructorIdToUser               Batch[]          @relation("Batch_instructorIdToUser")
  ClassSession_ClassSession_assessorIdToUser   ClassSession[]   @relation("ClassSession_assessorIdToUser")
  ClassSession_ClassSession_instructorIdToUser ClassSession[]   @relation("ClassSession_instructorIdToUser")
  Enrollment                                   Enrollment[]
  K3Log                                        K3Log[]
}

enum AssessmentStatus {
  PENDING
  KOMPETEN
  BELUM_KOMPETEN
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum BatchStatus {
  OPEN
  ONGOING
  COMPLETED
}

enum InstructorLevel {
  JUNIOR
  MADYA
  SENIOR
  MASTER
}

enum ProgramCategory {
  BNSP
  KEMENAKER
  INHOUSE
  SERTIFIKASI
  AUDIT
  LAINNYA
}

enum Role {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  ASSESSOR
  TRAINEE
  CLIENT_HR
  AUDITOR
}
