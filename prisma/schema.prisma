generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(uuid())
  email                String           @unique
  phone                String?          @unique
  fullName             String
  role                 Role             @default(TRAINEE)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  passwordHash         String?
  instructorLevel      InstructorLevel?
  licenseNumber        String?
  profilePictureUrl    String?
  participantDocuments Json?
  attendances          Attendance[]
  instructed           Batch[]          @relation("InstructorBatches")
  assessed             Batch[]          @relation("AssessorBatches")
  sessions             ClassSession[]   @relation("SessionInstructor")
  assessedSessions     ClassSession[]   @relation("SessionAssessor")
  enrollments          Enrollment[]
  verifiedLogs         K3Log[]          @relation("LogVerifier")
}

model Program {
  id             String          @id @default(uuid())
  title          String
  category       ProgramCategory
  industryType   String          @default("Umum")
  description    String?
  curriculum     Json?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customCategory String?
  batches        Batch[]
  unitSchemas    UnitSchema[]
  certificateConfig CertificateConfig?
}

model UnitSchema {
  id          String       @id @default(uuid())
  programId   String?
  code        String       @unique
  title       String
  level       String?
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  units       SchemaUnit[]
  program     Program?     @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model SchemaUnit {
  id           String     @id @default(uuid())
  unitSchemaId String
  unitCode     String
  title        String
  orderIndex   Int        @default(1)
  isMandatory  Boolean    @default(true)
  criteria     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  unitSchema   UnitSchema @relation(fields: [unitSchemaId], references: [id], onDelete: Cascade)

  @@unique([unitSchemaId, unitCode])
  @@index([unitSchemaId, orderIndex])
}

model Batch {
  id           String         @id @default(uuid())
  programId    String
  instructorId String?
  assessorId   String?
  startDate    DateTime
  endDate      DateTime
  quota        Int
  price        Int?
  pricePackages Json?
  status       BatchStatus    @default(OPEN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  classroomId  String?
  classroom    Classroom?     @relation(fields: [classroomId], references: [id])
  instructor   User?          @relation("InstructorBatches", fields: [instructorId], references: [id])
  assessor     User?          @relation("AssessorBatches", fields: [assessorId], references: [id])
  program      Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessions     ClassSession[]
  enrollments  Enrollment[]
}

model Enrollment {
  id               String           @id @default(uuid())
  batchId          String
  userId           String
  registrationDocs Json?
  assessmentStatus AssessmentStatus @default(PENDING)
  certificateNum   String?          @unique
  expiryDate       DateTime?
  qrVerifyCode     String           @unique @default(uuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  batch            Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id])
  k3Logs           K3Log[]

  @@unique([batchId, userId])
}

model Classroom {
  id          String         @id @default(uuid())
  roomName    String
  capacity    Int
  facilities  Json?
  isAvailable Boolean        @default(true)
  sessions    ClassSession[]
  batches     Batch[]
}

model ClassSession {
  id           String       @id @default(uuid())
  batchId      String
  classroomId  String?
  instructorId String?
  assessorId   String?
  title        String
  sessionDate  DateTime
  startTime    DateTime
  endTime      DateTime
  locationType String       @default("Classroom")
  jp           Int          @default(1)
  createdAt    DateTime     @default(now())
  attendances  Attendance[]
  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  classroom    Classroom?   @relation(fields: [classroomId], references: [id])
  instructor   User?        @relation("SessionInstructor", fields: [instructorId], references: [id])
  assessor     User?        @relation("SessionAssessor", fields: [assessorId], references: [id])
}

model Attendance {
  id             String           @id @default(uuid())
  sessionId      String
  userId         String
  checkInTime    DateTime         @default(now())
  gpsCoordinates Json?
  selfieUrl      String?
  status         AttendanceStatus @default(PRESENT)
  deviceInfo     String?
  session        ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

model K3Log {
  id           String     @id @default(uuid())
  enrollmentId String
  activityName String
  safetyScore  Int?
  verifiedById String?
  evidenceUrl  String?
  gpsWatermark Json?
  timestamp    DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  verifiedBy   User?      @relation("LogVerifier", fields: [verifiedById], references: [id])
}

model CertificateConfig {
  id              String   @id @default(uuid())
  programId       String?  @unique
  pdfTemplateUrl  String?
  signatureUrl    String?
  signatoryName   String?
  signatoryTitle  String?
  passingGrade    Int      @default(70)
  validityMonths  Int?
  updatedAt       DateTime @updatedAt

  program         Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  ASSESSOR
  TRAINEE
  CLIENT_HR
  AUDITOR
}

enum ProgramCategory {
  BNSP
  KEMENAKER
  INHOUSE
  SERTIFIKASI
  AUDIT
  LAINNYA
}

enum InstructorLevel {
  JUNIOR
  MADYA
  SENIOR
  MASTER
}

enum BatchStatus {
  OPEN
  ONGOING
  COMPLETED
}

enum AssessmentStatus {
  PENDING
  KOMPETEN
  BELUM_KOMPETEN
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

model Article {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  author          String
  content         String   @db.Text
  imageUrl        String?
  version         String   @default("1.0")
  publishDate     DateTime @default(now())
  seoDescription  String?
  seoKeywords     String?
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AiBrain {
  id          String   @id @default(uuid())
  purpose     String   @unique // e.g., "SEO_METADATA", "ARTICLE_GENERATOR"
  systemPrompt String   @db.Text
  updatedAt   DateTime @updatedAt
}
